{
    admin off
    auto_https disable_redirects
}

https://{$SHOWCASE_HOST} {
    tls /run/secrets/tls_cert /run/secrets/tls_key

    @backend path /api /api/* /health/ready
    handle @backend {
        reverse_proxy api:8000
    }

    handle /admin {
        redir /admin/ 308
    }
    handle_path /admin/* {
        root * /srv/admin
        try_files {path} /index.html
        file_server
    }
    handle {
        root * /srv/h5
        try_files {path} /index.html
        file_server
    }
}
