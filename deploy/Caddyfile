{
	admin off
	auto_https off
}

:443 {
	tls /run/secrets/tls_cert /run/secrets/tls_key

	@backend path /api /api/* /health/ready
	handle @backend {
		reverse_proxy api:8000 {
			header_up Host {http.request.hostport}
		}
	}
	handle /admin* {
		respond "admin is served on port 5001" 404
	}
	handle {
		root * /srv/h5
		try_files {path} /index.html
		file_server
	}
}

:444 {
	tls /run/secrets/tls_cert /run/secrets/tls_key

	@backend path /api /api/* /health/ready
	handle @backend {
		reverse_proxy api:8000 {
			header_up Host {http.request.hostport}
		}
	}
	handle /admin {
		redir * /admin/ 308
	}
	handle_path /admin/* {
		root * /srv/admin
		try_files {path} /index.html
		file_server
	}
	handle {
		redir * /admin/ 308
	}
}
