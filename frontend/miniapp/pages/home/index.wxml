<view class="home" bindtouchstart="onTouchStart" bindtouchend="onTouchEnd" bindtouchcancel="onTouchEnd">
  <block wx:if="{{phase === 'ready' && posters.length}}">
    <swiper class="poster-track" current="{{current}}" circular="{{posters.length > 1}}" bindchange="onSlideChange">
      <swiper-item wx:for="{{posters}}" wx:key="*this">
        <scroll-view class="poster-scroll" scroll-y bindscroll="onPosterScroll" data-src="{{item}}" data-version="{{posterVersion}}">
          <image wx:if="{{mountedPosters[item]}}" class="poster-image" mode="widthFix" src="{{item}}" webp="{{true}}" aria-label="企业产品海报，第 {{index + 1}} 张"
            bindload="onPosterLoad" binderror="onPosterError" data-src="{{item}}" data-version="{{posterVersion}}" />
        </scroll-view>
      </swiper-item>
    </swiper>
    <scroll-view wx:if="{{posters.length > 1}}" class="poster-dots" scroll-x aria-label="海报翻页">
      <view class="poster-dot-list">
        <button wx:for="{{posters}}" wx:key="*this" class="poster-dot {{index === current ? 'poster-dot-active' : ''}}"
          data-index="{{index}}" bindtap="selectPoster"
          aria-label="{{index === current ? '正在查看' : '查看'}}第 {{index + 1}} 张海报">
          <view class="poster-dot-mark" />
        </button>
      </view>
    </scroll-view>
  </block>
  <view wx:elif="{{phase === 'loading'}}" class="notice">正在加载海报…</view>
  <view wx:elif="{{phase === 'error'}}" class="notice">
    <view class="notice-title">海报加载失败</view>
    <text wx:if="{{message}}">{{message}}</text>
    <button class="soft-button" bindtap="retry">重试</button>
  </view>
  <view wx:else class="notice">
    <view class="notice-title">暂无展示海报</view>
    <button class="soft-button" bindtap="retry">重新加载</button>
  </view>
</view>
