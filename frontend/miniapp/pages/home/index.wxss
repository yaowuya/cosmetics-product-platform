page {
  height: 100%;
  overflow: hidden;
  background: #fff;
}

.home {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  overflow: hidden;
}

/* 1228:2048 海报参考高度；矮屏由 flex 收缩，图像本身不裁切。 */
.poster-track {
  flex: 0 1 auto;
  width: 100%;
  height: 1251rpx;
  min-height: 0;
}

.poster-scroll {
  width: 100%;
  height: 100%;
}

.poster-image {
  display: block;
  width: 100%;
}

.poster-dots {
  flex: 0 0 70rpx;
  height: 70rpx;
  text-align: center;
  white-space: nowrap;
}

.poster-dot-list {
  display: inline-flex;
  height: 100%;
  align-items: center;
  padding: 0 20rpx;
}

.poster-dot {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 58rpx;
  width: 58rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  background: transparent;
}

.poster-dot::after {
  border: 0;
}

.poster-dot-mark {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #d3e1ec;
}

.poster-dot-active .poster-dot-mark {
  width: 14rpx;
  height: 14rpx;
  background: #69a6ca;
  box-shadow: 0 0 0 6rpx rgba(105, 166, 202, .13);
}
