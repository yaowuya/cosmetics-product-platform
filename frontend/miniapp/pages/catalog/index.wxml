<view class="screen catalog-screen">
  <view wx:if="{{(cover.image && !coverFailed) || cover.top || cover.bottom}}" class="catalog-hero">
    <image wx:if="{{cover.image && !coverFailed}}" src="{{cover.image}}" mode="aspectFill" data-src="{{cover.image}}" binderror="onCoverError" aria-label="产品目录封面" />
    <view wx:if="{{(cover.top || cover.bottom) && (!cover.imageHasText || coverFailed)}}" class="catalog-slogan">
      <text>{{cover.top}}</text><text class="slogan-main">{{cover.bottom}}</text>
    </view>
  </view>
  <view wx:if="{{configPhase === 'loading'}}" class="notice">正在加载目录…</view>
  <view wx:elif="{{configPhase === 'error'}}" class="notice">
    <text class="notice-title">{{configMessage}}</text><button class="soft-button" bindtap="onRetry">重试</button>
  </view>
  <view wx:elif="{{!boards.length}}" class="notice">
    <text class="notice-title">暂无已发布的产品目录</text><button class="soft-button" bindtap="onRefresh">刷新目录</button>
  </view>
  <block wx:else>
    <view class="catalog-tools">
      <view class="searchbox">
        <view class="magnifier" aria-hidden="true"></view>
        <input value="{{q}}" placeholder="搜索产品 / 编号" aria-label="搜索产品或配方编号" confirm-type="search" maxlength="250" bindinput="onSearch" />
        <button wx:if="{{q}}" class="search-clear" bindtap="onClear" aria-label="清空搜索">×</button>
      </view>
      <scroll-view class="board-strip" scroll-x enable-flex show-scrollbar="{{false}}">
        <view class="board-items">
          <button wx:for="{{boards}}" wx:key="id" class="board-button {{board === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="onBoard" aria-pressed="{{board === item.id}}">
            <view class="board-icon" aria-hidden="true">
              <image src="{{item.displayIcon}}" mode="aspectFit" data-id="{{item.id}}" data-src="{{item.displayIcon}}" binderror="onBoardIconError" />
            </view>
            <text class="board-label">{{item.name}}</text>
            <view wx:if="{{board === item.id}}" class="board-indicator" aria-hidden="true"></view>
          </button>
        </view>
      </scroll-view>
    </view>
    <view class="catalog-body">
      <scroll-view wx:if="{{categories.length}}" class="catalog-rail" scroll-y scroll-top="{{leftTop}}" bindscroll="onLeftScroll">
        <button wx:for="{{categories}}" wx:key="id" data-id="{{item.id}}" class="category-button {{category === item.id ? 'active' : ''}}" bindtap="onCategory" aria-pressed="{{category === item.id}}"><text>{{item.name}}</text></button>
      </scroll-view>
      <scroll-view class="catalog-results" scroll-y scroll-top="{{rightTop}}" bindscroll="onRightScroll" refresher-enabled refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresh">
        <view wx:if="{{searchActive}}" class="filter-row search-result">
          <text>{{phase === 'loading' ? '搜索中…' : (phase === 'error' ? '搜索产品' : '找到 ' + total + ' 款')}}</text>
          <button class="filter-clear" bindtap="onClear">清空</button>
        </view>
        <view wx:else class="filter-row">
          <scroll-view class="fine-strip" scroll-x enable-flex show-scrollbar="{{false}}">
            <view class="fine-items">
              <button class="fine-button {{fine ? '' : 'active'}}" bindtap="onFine" aria-pressed="{{!fine}}"><text>全部</text></button>
              <button wx:for="{{fineChoices}}" wx:key="id" class="fine-button {{fine === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="onFine" aria-pressed="{{fine === item.id}}"><text>{{item.name}}</text></button>
            </view>
          </scroll-view>
          <text class="catalog-count">{{count}} 款</text>
        </view>
        <view wx:if="{{phase === 'loading'}}" class="notice">正在加载产品…</view>
        <view wx:elif="{{phase === 'error'}}" class="notice">
          <text class="notice-title">产品加载失败</text><button class="soft-button" bindtap="onRetry">重试</button>
        </view>
        <view wx:elif="{{phase === 'empty'}}" class="notice">
          <text class="notice-title">{{searchActive ? '没有找到相关产品' : '该分类暂无展示产品'}}</text>
          <button wx:if="{{searchActive}}" class="soft-button" bindtap="onClear">重新查找</button>
        </view>
        <button wx:for="{{items}}" wx:key="imageKey" class="product-row" data-id="{{item.id}}" bindtap="onOpenProduct">
          <image wx:if="{{item.thumbnail && failedThumbnails[item.id] !== item.thumbnail}}" class="product-thumb" src="{{item.thumbnail}}" mode="aspectFit"
            lazy-load="{{true}}" webp="{{true}}" data-id="{{item.id}}" data-src="{{item.thumbnail}}" data-version="{{item.imageVersion}}" binderror="onImageError" />
          <image wx:elif="{{item.image && broken[item.id] !== item.image}}" class="product-thumb" src="{{item.image}}" mode="aspectFit"
            lazy-load="{{true}}" webp="{{true}}" data-id="{{item.id}}" data-src="{{item.image}}" data-version="{{item.imageVersion}}" binderror="onImageError" />
          <view wx:else class="product-thumb placeholder" aria-hidden="true"></view>
          <view class="product-summary"><text class="product-name">{{item.name}}</text><text wx:if="{{item.short}}" class="product-benefit">{{item.short}}</text></view>
        </button>
        <view wx:if="{{phase === 'appending'}}" class="notice">正在加载更多…</view>
        <view wx:elif="{{phase === 'append-error'}}" class="notice">
          <text>加载更多失败，已显示的产品仍可查看。</text><button class="soft-button" bindtap="onRetry">重试加载</button>
        </view>
        <button wx:elif="{{hasMore}}" class="catalog-more soft-button" bindtap="onLoadMore">加载更多</button>
      </scroll-view>
    </view>
  </block>
</view>
