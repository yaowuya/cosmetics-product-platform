.catalog-screen { height:100vh; display:flex; flex-direction:column; overflow:hidden; }
.catalog-hero { position:relative; height:0; flex:none; padding-top:38.46%; overflow:hidden; background:#edf6fc; }
.catalog-hero image { position:absolute; inset:0; width:100%; height:100%; }
.catalog-slogan { position:absolute; left:34rpx; top:50%; max-width:80%; transform:translateY(-50%); display:flex; flex-direction:column; color:#152d3c; font-size:26rpx; text-shadow:0 1rpx 16rpx #fff; }
.slogan-main { font-size:42rpx; font-weight:700; }
.catalog-tools { flex:none; padding:20rpx 22rpx 0; border-bottom:1rpx solid #e6edf2; }
.searchbox { display:flex; align-items:center; gap:20rpx; height:74rpx; padding:0 22rpx; border-radius:40rpx; background:#f3f6f8; color:#58636e; }
.searchbox input { flex:1; min-width:0; font-size:26rpx; }
.magnifier { position:relative; width:26rpx; height:26rpx; border:3rpx solid #4888b5; border-radius:50%; flex:none; }
.magnifier::after { content:''; position:absolute; width:13rpx; height:3rpx; right:-10rpx; bottom:-5rpx; background:#4888b5; transform:rotate(45deg); }
.search-clear { width:54rpx; min-height:64rpx; font-size:38rpx; color:#4e5e69; }
.board-strip { width:100%; }
.board-items { display:inline-flex; min-width:100%; padding-top:6rpx; }
.board-button { position:relative; flex:1 0 130rpx; min-width:0; min-height:104rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; padding:4rpx 8rpx 8rpx; font-size:23rpx; }
.board-icon { display:flex; align-items:center; justify-content:center; flex:none; width:64rpx; height:48rpx; border-radius:16rpx; }
.board-icon image { width:36rpx; height:36rpx; }
.board-label { display:block; max-width:100%; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.board-button.active .board-icon { background:#edf6fc; }
.board-indicator { position:absolute; left:50%; bottom:0; transform:translateX(-50%); width:36rpx; height:4rpx; border-radius:4rpx; background:#69a6ca; }
.catalog-body { flex:auto; min-height:0; display:flex; }
.catalog-rail { width:168rpx; height:100%; flex:none; background:#f7f9fb; }
.category-button, .fine-button { display:flex; align-items:center; justify-content:center; text-align:center; }
.category-button { width:100%; min-height:92rpx; padding:15rpx 16rpx; border:5rpx solid transparent; border-width:0 5rpx; color:#43515b; font-size:25rpx; }
.category-button text { min-width:0; overflow-wrap:anywhere; }
.category-button.active { border-left-color:#4888b5; background:#fff; color:#245b82; font-weight:700; }
.catalog-results { flex:1; width:0; min-width:0; height:100%; }
.filter-row { min-height:82rpx; display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding:4rpx 20rpx; border-bottom:1rpx solid #e6edf2; }
.search-result { font-size:25rpx; color:#475662; }
.filter-clear { color:#29668f; min-height:64rpx; padding:0 10rpx; }
.fine-strip { min-width:0; flex:1; }
.fine-items { display:inline-flex; gap:8rpx; }
.fine-button { flex:none; min-height:62rpx; max-width:230rpx; padding:0 13rpx; color:#485965; font-size:24rpx; border-radius:20rpx; }
.fine-button text { display:block; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.fine-button.active { color:#29668f; background:#edf6fc; font-weight:700; }
.catalog-count { flex:none; font-size:23rpx; color:#58636e; }
.product-row { width:auto; min-width:0; display:flex; align-items:center; gap:20rpx; margin:0 20rpx; padding:16rpx 0; border-bottom:1rpx solid #e6edf2; text-align:left; }
.product-thumb { flex:none; width:108rpx; height:108rpx; border-radius:10rpx; }
.product-summary { flex:1; min-width:0; display:flex; flex-direction:column; gap:8rpx; overflow-wrap:anywhere; }
.product-name { color:#000; font-size:27rpx; font-weight:650; }
.product-benefit { color:#58636e; font-size:23rpx; }
.catalog-more { display:flex; margin:24rpx auto; }
