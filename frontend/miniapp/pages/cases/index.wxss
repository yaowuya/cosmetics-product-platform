.cases-hero {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 150rpx;
  padding: 20rpx 50rpx 16rpx;
  background: #f5faff;
  overflow: hidden;
}
.cases-hero-image, .case-card-image {
  position: absolute;
  top: 0;
  left: 0;
  display: block;
  width: 100%;
  height: 100%;
}
.cases-hero-copy { position: relative; min-width: 0; overflow-wrap: anywhere; }
.cases-title { font-size: 42rpx; font-weight: 600; letter-spacing: 0.6rpx; }
.cases-intro { margin-top: 8rpx; font-size: 23rpx; white-space: pre-line; }
.cases-tools {
  position: relative;
  margin-top: -6rpx;
  padding: 20rpx 32rpx 22rpx;
  border-radius: 36rpx 36rpx 0 0;
  background: #fff;
}
.cases-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 72rpx;
  margin: 0 8rpx 20rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e4ecf2;
  border-radius: 44rpx;
  background: #f8fafc;
}
.search-icon {
  position: relative;
  flex: none;
  width: 24rpx;
  height: 24rpx;
  margin-right: 4rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
}
.search-icon::after {
  position: absolute;
  right: -7rpx;
  bottom: -3rpx;
  width: 11rpx;
  height: 2rpx;
  background: currentColor;
  transform: rotate(45deg);
  content: '';
}
.cases-input { flex: 1; width: 0; min-width: 0; height: 68rpx; font-size: 30rpx; }
.cases-clear { flex: none; width: 66rpx; min-height: 68rpx; font-size: 38rpx; }
.case-filters { width: 100%; white-space: nowrap; }
.case-filter-track { display: inline-flex; min-width: 100%; gap: 10rpx; padding: 6rpx 0; }
.case-filter {
  flex: 1 0 auto;
  min-width: 106rpx;
  min-height: 72rpx;
  padding: 10rpx 16rpx;
  border-radius: 14rpx;
  background: #f0f4fa;
  font-size: 22rpx;
  white-space: nowrap;
}
.case-filter-active { background: #4e8bdb; box-shadow: 0 4rpx 10rpx rgba(66,127,200,0.1); }
.case-results { padding: 0 28rpx 40rpx; }
.case-grid { display: flex; flex-wrap: wrap; gap: 20rpx 16rpx; }
.case-card {
  display: block;
  min-width: 0;
  overflow: hidden;
  border-radius: 20rpx;
  background: #f9fbfe;
  text-align: left;
}
.case-grid .case-card { flex: 0 0 calc(50% - 8rpx); }
.case-card-pressed { opacity: 0.76; }
.case-card-media { position: relative; width: 100%; padding-top: 45.4545%; }
.case-featured {
  display: flex;
  width: 100%;
  min-height: 340rpx;
  border-radius: 24rpx;
  background: #edf5fc;
}
.case-featured .case-card-media { flex: 0 0 61%; padding-top: 0; background: #e8f2fb; }
.case-copy { display: flex; flex-direction: column; gap: 6rpx; padding: 10rpx 18rpx 12rpx; overflow-wrap: anywhere; }
.case-featured .case-copy {
  flex: 1;
  min-width: 0;
  justify-content: center;
  gap: 16rpx;
  padding: 28rpx 20rpx;
  background: #f1f7fc;
}
.case-brand { font-size: 25rpx; font-weight: 500; }
.case-featured .case-brand { font-size: 28rpx; }
.case-name { font-size: 24rpx; }
.case-highlight { font-size: 23rpx; }
.cases-grid-title { display: flex; align-items: center; gap: 16rpx; margin: 26rpx 0 22rpx; font-size: 28rpx; font-weight: 500; }
.cases-grid-title::before { width: 6rpx; height: 30rpx; border-radius: 4rpx; background: #5e99df; content: ''; }
.cases-more { display: flex; justify-content: center; margin-top: 24rpx; }
